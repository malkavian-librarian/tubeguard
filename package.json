{
  "name": "tubeguard",
  "version": "0.1.0",
  "description": "Block channels, track your watch time, and take back control of YouTube.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/background/service-worker.js src/content/content-main.js --bundle --outdir=build --format=esm --entry-names=[name]",
    "build:watch": "esbuild src/background/service-worker.js src/content/content-main.js --bundle --outdir=build --format=esm --entry-names=[name] --watch",
    "zip": "powershell -Command \"Compress-Archive -Path build,src/stats,src/popup,src/shared,assets,manifest.json -DestinationPath tubeguard.zip -Force\""
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
